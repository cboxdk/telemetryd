.DS_Store

# cargo-fuzz working directories. `fuzz/seeds/` is the committed starting corpus;
# everything the fuzzer discovers from it is reproducible and belongs to a run, not
# to the repository.
/fuzz/corpus
/fuzz/artifacts
/fuzz/target
/fuzz/Cargo.lock

# Assembled into the Docker build context by scripts/docker-context.py.
# A release artifact, never a source file — 40 MB of binary does not belong in git.
docker/telemetryd-linux-*

# Python bytecode from running the soak in-process during development.
__pycache__/
*.pyc
